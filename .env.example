# ==============================================================================
# BioGuardian Full-Stack Environment Variables Template
# Copy this file to .env or create service-specific .env files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend Server (`/server`)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MQTT Ingestion Gateway
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Supabase / PostgreSQL Database (Optional - defaults to in-memory cache)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Push / Alert Dispatcher (Optional)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Web Client (`/frontend-web`)
# NOTE: Next.js requires the NEXT_PUBLIC_ prefix for client-side browser exposure.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_DEVICE_ID=BG-ESP32-001

