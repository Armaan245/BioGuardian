# ==========================================
# BioGuardian Frontend Environment Variables
# ==========================================

# Base URL for the BioGuardian FastAPI backend server.
# In Next.js client code, only variables prefixed with NEXT_PUBLIC_ are accessible in the browser.
# Defaults to http://localhost:8000 (or set to your port/cloud host e.g. http://localhost:8004, https://api.bioguardian.org)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base WebSocket URL for real-time telemetry streaming.
# Optional: If omitted, the frontend automatically derives ws:// (for http) or wss:// (for https)
# directly from NEXT_PUBLIC_API_BASE_URL!
# Examples: ws://localhost:8000, wss://your-api-domain.com
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Active hardware / twin device identifier
NEXT_PUBLIC_DEVICE_ID=BG-ESP32-001

